{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jellyfin-ios-audio/phase0-evidence.schema.json",
  "title": "Phase 0 evidence record common envelope",
  "description": "Common integrity envelope for every JSON evidence record under docs/evidence/phase-0. Record-specific payload rules are enforced by tools/phase0/validate_evidence.py.",
  "type": "object",
  "required": [
    "schemaVersion",
    "proofId",
    "capturedAt",
    "command",
    "environment",
    "owner",
    "status",
    "limitations",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "proofId": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "owner": {
      "type": "object",
      "required": ["phase", "workstream"],
      "properties": {
        "phase": {"const": "Phase 0"},
        "workstream": {
          "enum": [
            "automation",
            "connectivity",
            "device",
            "network",
            "platform",
            "playback"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {"enum": ["pass", "fail", "blocked", "not-run"]},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "privacy": {
      "type": "object",
      "required": ["redacted", "committedEvidenceContainsSecrets", "privateServerDataPersisted"],
      "properties": {
        "redacted": {"const": true},
        "committedEvidenceContainsSecrets": {"const": false},
        "privateServerDataPersisted": {"const": false},
        "omitted": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "status", "facts", "limitations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "blocked", "not-run"]},
        "facts": {"type": "object"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
